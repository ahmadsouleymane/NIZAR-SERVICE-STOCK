# Nizar Stock — configuration de production
# Copier ce fichier en `.env` et le remplir.

# Port du serveur
PORT=3000

# Secret JWT — OBLIGATOIRE en production (sinon le serveur refuse de demarrer).
# Generer avec : openssl rand -hex 32
JWT_SECRET=

# Passer a production pour masquer les comptes par defaut dans les logs.
# NODE_ENV=production

# Optionnel : origine autorisee pour l'API si un autre domaine doit y acceder
# (par defaut : same-origin uniquement, aucune origine tierce).
# CORS_ORIGIN=https://stock.example.com

# Emplacement de la base de donnees et des uploads.
# En deploiement (Render/Railway/Fly) : pointer vers le disque persistant.
# DB_PATH=/data/nizar.db
# UPLOAD_DIR=/data/uploads
